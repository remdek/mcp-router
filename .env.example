# Embeddings: remote API if URL + model are set, otherwise local CPU (fastembed)
# EMBEDDING_URL=http://localhost:1234/v1
# EMBEDDING_MODEL=text-embedding-multilingual-e5-small
# EMBEDDING_API_KEY=
# LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Rebuild tool index on container start (background by default)
REINDEX_ON_START=true
REINDEX_BACKGROUND=true

# Periodic downstream health probes (tools/list; updates /status without reindex)
HEALTH_PROBE_ENABLED=true
HEALTH_PROBE_INTERVAL_SEC=60
HEALTH_PROBE_TIMEOUT_SEC=15
HEALTH_PROBE_CONCURRENCY=4
# Day-path quarantine: drop tools / block calls for failed_servers (WOR-1092)
HEALTH_QUARANTINE_ENABLED=true

# Optional Bearer auth for /mcp and /mcp/v2
ROUTER_API_KEY=
INDEX_TOOLS_TIMEOUT_SEC=60

# CORS origins (comma-separated). Default "*" is fine on LAN; for a public host
# set an explicit allowlist and also set ROUTER_API_KEY (see README).
# ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
ALLOWED_ORIGINS=*

# Strict dual MCP surface (WOR-816): /mcp = full; /mcp/v2 = allow-list
STRICT_MCP_ENABLED=true
# STRICT_ALLOWLIST=hindsight,searxng,graphiti:search_nodes
# STRICT_ALLOWLIST={"servers":["hindsight"],"tools":[],"read_only":false}
# STRICT_READ_ONLY=false

# Router HTTP server
# HOST_PORT — published on the host by docker compose; MCP_ROUTER_PORT — listen port inside the container
HOST_PORT=8000
MCP_ROUTER_HOST=0.0.0.0
MCP_ROUTER_PORT=8000

# Paths (host defaults; docker-compose overrides REGISTRY_PATH / INDEX_DB_PATH for bind mounts)
REGISTRY_PATH=config/registry.json
INDEX_DB_PATH=data/tools.db
ALIASES_PATH=config/aliases.json

# Search quality loop (WOR-813)
# SHADOW_RANKER=false keeps baseline RRF visible; set true to log weighted shadow pages
SHADOW_RANKER=false
# ALIAS_BOOST=1.35
# SEARCH_OUTCOME_WINDOW_SEC=600

# Docker build: install Playwright MCP + Chrome for Testing in image (~300MB extra)
# PLAYWRIGHT_INSTALL=true

# MCP server secrets / URLs (substituted in registry.json as ${VAR})
GITHUB_PERSONAL_ACCESS_TOKEN=
CONTEXT7_API_KEY=
GITLAB_PERSONAL_ACCESS_TOKEN=
# GITLAB_API_URL=https://gitlab.com/api/v4
# SEARXNG_URL=http://localhost:8080
# CRAWL4AI_BASE_URL=http://localhost:11235
